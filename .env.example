# Agent provider: "mock" (default, deterministic, no network) or "openai-compatible".
NEXT_PUBLIC_AGENT_PROVIDER=mock

# Only used when NEXT_PUBLIC_AGENT_PROVIDER=openai-compatible (server-side only).
# Works with OpenAI, Azure OpenAI (set LLM_BASE_URL to the deployment endpoint) or any compatible gateway.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
